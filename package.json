{
  "name": "multi-file-reader",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/Akshith17323/Multi-File-Reader#readme",
  "bugs": {
    "url": "https://github.com/Akshith17323/Multi-File-Reader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshith17323/Multi-File-Reader.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "apps/electron/main.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\" --names \"SERVER,WEB\" --prefix-colors \"blue,green\"",
    "dev:all": "concurrently \"npm run server\" \"npm run web\" \"npm run start:electron\" --names \"SERVER,WEB,ELECTRON\" --prefix-colors \"blue,green,magenta\"",
    "web": "npm --workspace=apps/web run dev",
    "server": "npm --workspace=apps/server start",
    "start:electron": "electron apps/electron",
    "electron": "concurrently \"npm run server\" \"npm run web\" \"npm run start:electron\" --names \"SERVER,WEB,ELECTRON\" --prefix-colors \"blue,green,magenta\"",
    "build": "npm --workspace=apps/web run build",
    "lint": "npm --workspace=apps/web run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.4.5"
  }
}