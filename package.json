{
  "name": "multi-file-reader",
  "version": "1.0.0",
  "description": "Read PDF, EPUB, and text documents in one desktop library.",
  "homepage": "https://github.com/Akshith17323/Multi-File-Reader#readme",
  "bugs": {
    "url": "https://github.com/Akshith17323/Multi-File-Reader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshith17323/Multi-File-Reader.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "apps/electron/main.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\" --names \"SERVER,WEB\" --prefix-colors \"blue,green\"",
    "dev:all": "npm run electron",
    "web": "npm --workspace=apps/web run dev",
    "server": "npm --workspace=apps/server start",
    "start": "electron .",
    "start:electron": "node apps/electron/services/DevLauncher.js --desktop-only",
    "electron": "node apps/electron/services/DevLauncher.js",
    "build:web": "npm --workspace=apps/web run build",
    "build:reader": "node apps/electron/scripts/build.js",
    "build": "npm run build:reader && electron-builder --publish never",
    "build:electron": "npm run build",
    "package:electron": "npm run build:reader && electron-builder --dir --publish never",
    "lint": "npm --workspace=apps/web run lint",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.akshith.multireader",
    "productName": "MultiReader",
    "asar": true,
    "files": [
      "package.json",
      "apps/electron/main.js",
      "apps/electron/preload.js",
      "apps/electron/adapters/**/*.js",
      "apps/electron/services/ApiProxyService.js",
      "apps/electron/services/PackagedWebServer.js",
      "apps/server/src/utils/fileTypes.js"
    ],
    "extraResources": [
      {
        "from": "apps/web/.next",
        "to": "web",
        "filter": [
          "standalone/**/*",
          "!**/.env*",
          "!**/*.local.*",
          "!**/*.map",
          "!**/AGENTS.md"
        ]
      }
    ],
    "extraMetadata": {
      "author": "Akshith",
      "desktop": {
        "backendUrl": "https://multi-file-reader-server.vercel.app"
      }
    },
    "beforePack": "./apps/electron/scripts/build.js",
    "afterPack": "./apps/electron/scripts/build.js",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "concurrently": "^9.2.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  }
}
